@model NEXUS.Modules.DecisionEngine.Presentation.DecisionEngineViewModel
@{
    var dec = Model.ActiveDecision;
    var exp = Model.Explanation;
}

<section class="command-panel" style="margin-bottom:18px;">
    <div class="panel-header-bar">
        <h1 class="panel-title"><span class="status-led amber"></span> AUTONOMOUS DECISION ENGINE — @dec.DecisionCode (@dec.RecommendedStrategyCode)</h1>
        <form method="post" action="/DecisionEngine/Generate" style="display:flex;gap:8px;align-items:center;">
            @Html.AntiForgeryToken()
            <select name="scenarioId" style="background:#0a0e13;color:#e6edf5;border:1px solid #324052;padding:7px 10px;border-radius:4px;font-family:monospace;">
                @foreach (var s in Model.Scenarios)
                {
                    <option value="@s.Id" selected="@(s.Id == dec.ScenarioId)">@s.ScenarioCode — @s.Name</option>
                }
            </select>
            <button type="submit" class="physical-button physical-button-primary">GENERATE AUTONOMOUS DECISION</button>
        </form>
    </div>

    <div class="explainability-triad">
        <div class="inset-panel">
            <div class="metric-display-label">WHAT (RECOMMENDED ACTION)</div>
            <div style="font-size:17px;font-weight:800;color:#f8fafc;margin-top:6px;">@exp.WhatStatement</div>
            <div class="text-muted mono-num" style="margin-top:8px;">Candidate Strategies Evaluated: @dec.CandidateStrategiesGenerated | Simulations: @dec.SimulationsCompleted.ToString("N0")</div>
        </div>

        <div class="inset-panel">
            <div class="metric-display-label">WHY (MATHEMATICAL &amp; OPERATIONAL PROOF)</div>
            <ul style="margin:6px 0 0;padding-left:18px;font-family:monospace;font-size:12px;">
                @foreach (var bullet in exp.WhyBullets)
                {
                    <li>@bullet</li>
                }
            </ul>
        </div>

        <div class="inset-panel">
            <div class="metric-display-label">EXPECTED RESULT</div>
            <div class="mono-num" style="margin-top:6px;display:grid;grid-template-columns:1fr 1fr;gap:6px;">
                <div>Revenue Protected: <strong class="text-emerald">@exp.ExpectedResultRevenueProtected</strong></div>
                <div>Additional Cost: <strong class="text-amber">@exp.ExpectedResultAdditionalCost</strong></div>
                <div>Service Level: <strong class="text-cyan">@exp.ExpectedResultServiceLevel</strong></div>
                <div>Risk Reduction: <strong class="text-emerald">@exp.ExpectedResultRiskReduction</strong></div>
            </div>
        </div>
    </div>

    <!-- Human-in-the-Loop Governance Bar -->
    <div class="control-panel" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
        <div>
            <span class="badge-chip @(dec.Status == "APPROVED" || dec.Status == "EXECUTED" ? "optimal" : dec.Status == "REJECTED" ? "critical" : "medium")">
                GOVERNANCE STATUS: @dec.Status
            </span>
            <span class="mono-num text-muted" style="margin-left:10px;">
                HUMAN-IN-THE-LOOP: @(dec.RequiresHumanApproval ? "EXPLICIT MANAGER APPROVAL REQUIRED" : "AUTO")
            </span>
        </div>

        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
            <form method="post" action="/DecisionEngine/Approve" style="display:inline-flex;gap:6px;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="decisionId" value="@dec.Id" />
                <input type="text" name="comments" placeholder="Manager review note..." style="background:#0a0e13;color:#e6edf5;border:1px solid #324052;padding:7px 10px;border-radius:4px;font-family:monospace;" />
                <button type="submit" class="physical-button physical-button-success">APPROVE (@dec.RecommendedStrategyCode)</button>
            </form>

            <form method="post" action="/DecisionEngine/Reject" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="decisionId" value="@dec.Id" />
                <button type="submit" class="physical-button physical-button-danger">REJECT</button>
            </form>

            <form method="post" action="/DecisionEngine/Execute" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="decisionId" value="@dec.Id" />
                <button type="submit" class="physical-button physical-button-primary" @(dec.Status == "REJECTED" ? "disabled" : "")>
                    EXECUTE APPROVED STRATEGY
                </button>
            </form>
        </div>
    </div>
</section>

<div class="grid-2" style="margin-bottom:18px;">
    <!-- Decision Frontier (Section 17) -->
    <section class="metal-panel">
        <div class="panel-header-bar">
            <h2 class="panel-title"><span class="status-led cyan"></span> PARETO DECISION FRONTIER (COST VS. RESILIENCE &amp; SERVICE)</h2>
        </div>

        <div class="pareto-strategy-grid">
            @foreach (var opt in dec.Options)
            {
                <div class="inset-panel @(opt.IsRecommended ? "strategy-card-recommended" : "")">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                        <strong class="mono-num text-cyan">@opt.StrategyCode</strong>
                        <span class="badge-chip @opt.RiskLabel.ToLowerInvariant()">Risk: @opt.RiskLabel</span>
                    </div>
                    <div class="mono-num" style="font-size:12.5px;line-height:1.7;">
                        <div>Cost: <strong>$@((opt.CostUsd / 1_000_000m).ToString("F1"))M</strong></div>
                        <div>Risk: <strong>@opt.RiskLabel</strong></div>
                        <div>Service: <strong class="text-emerald">@opt.ServiceLevelPct.ToString("F0")%</strong></div>
                        <div>Resilience: <strong class="text-amber">@opt.ResilienceScore.ToString("F0") / 100</strong></div>
                    </div>
                </div>
            }
        </div>

        <div class="inset-panel">
            <div class="metric-display-label">OR-TOOLS BINDING CONSTRAINTS &amp; SENSITIVITY</div>
            @foreach (var b in exp.BindingConstraints)
            {
                <div class="mono-num text-muted" style="font-size:11.5px;margin-top:4px;">• @b</div>
            }
            @foreach (var s in exp.SensitivityInsights)
            {
                <div class="mono-num text-cyan" style="font-size:11.5px;margin-top:4px;">• @s</div>
            }
        </div>
    </section>

    <!-- Decision Time Machine / Decision Replay (Section 21) -->
    <section class="metal-panel">
        <div class="panel-header-bar">
            <h2 class="panel-title"><span class="status-led"></span> DECISION TIME MACHINE — DECISION REPLAY</h2>
            <button type="button" id="btn-start-decision-replay" class="physical-button">REPLAY DECISION TIMELINE</button>
        </div>

        <div class="replay-timeline">
            @foreach (var item in Model.ReplayTimeline)
            {
                <div class="replay-item">
                    <span class="mono-num text-amber" style="font-weight:700;">@item.Time</span>
                    <strong>@item.Event</strong>
                    <span class="text-muted">@item.Detail</span>
                </div>
            }
        </div>
    </section>
</div>

<!-- Grounded AI Decision Assistant (Section 19) -->
<section class="metal-panel">
    <div class="panel-header-bar">
        <h2 class="panel-title"><span class="status-led cyan"></span> AI DECISION ASSISTANT (GROUNDED IN DIGITAL TWIN, MONTE CARLO &amp; OR-TOOLS)</h2>
        <span class="badge-chip optimal">ZERO HALLUCINATION • DETERMINISTIC EVIDENCE</span>
    </div>

    <div style="display:flex;gap:10px;align-items:center;">
        <input type="text" id="input-ai-question"
               value="Our European supplier will lose 40% capacity for two weeks. What should we do?"
               style="flex:1;background:#0a0e13;color:#e6edf5;border:1px solid #324052;padding:10px 14px;border-radius:4px;font-family:monospace;font-size:13px;" />
        <button type="button" id="btn-ask-ai-assistant" class="physical-button physical-button-primary">
            ASK GROUNDED AI AGENT
        </button>
    </div>

    <div id="ai-assistant-output" hidden></div>
</section>
