@{
    ViewData["Title"] = "Unexpected error";
}

<section class="nexus-panel nexus-panel-form" style="max-width:720px;margin:40px auto;">
    <div class="nexus-panel-header"><h1>Something went wrong</h1></div>
    <p role="alert">NEXUS could not complete that request. The incident has been logged. No calculated supply-chain result was changed by this error.</p>
    <a class="nexus-button nexus-button-primary" asp-controller="CommandCenter" asp-action="Index">Return to Command Center</a>
</section>
