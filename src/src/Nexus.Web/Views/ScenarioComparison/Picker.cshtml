@model List<Scenario>
@{
    ViewData["Title"] = "Compare Scenarios";
}

<section class="nexus-panel">
    <div class="nexus-panel-header">
        <h2>Compare Scenarios</h2>
        <span class="nexus-panel-subtitle">Select 2-3 scenarios to compare side by side (§12)</span>
    </div>

    @if (!Model.Any())
    {
        <p class="nexus-muted">No scenarios with computed results yet. Run a simulation first.</p>
    }
    else
    {
        <form method="get" asp-controller="ScenarioComparison" asp-action="Index">
            <table class="nexus-table">
                <thead><tr><th></th><th>Scenario</th><th>Revenue at Risk</th><th>Recovery</th></tr></thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td><input type="checkbox" name="ids" value="@s.Id" /></td>
                            <td>@s.Name</td>
                            <td>$@s.LastResult!.RevenueAtRisk.ToString("N0")</td>
                            <td>@s.LastResult.RecoveryDays days</td>
                        </tr>
                    }
                </tbody>
            </table>
            <button type="submit" class="nexus-button nexus-button-primary" style="margin-top:12px;">Compare Selected</button>
        </form>
    }
</section>
