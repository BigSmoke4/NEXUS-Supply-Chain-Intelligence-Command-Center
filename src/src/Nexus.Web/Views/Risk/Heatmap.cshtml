@model List<HeatmapCell>
@{
    ViewData["Title"] = "Risk Heatmap";

    string Bucket(double v) => v >= 0.66 ? "High" : v >= 0.33 ? "Med" : "Low";

    var grid = new Dictionary<(string Prob, string Impact), List<HeatmapCell>>();
    foreach (var probBucket in new[] { "High", "Med", "Low" })
        foreach (var impactBucket in new[] { "Low", "Med", "High" })
            grid[(probBucket, impactBucket)] = new List<HeatmapCell>();

    foreach (var cell in Model)
        grid[(Bucket(cell.Probability), Bucket(cell.ImpactScore))].Add(cell);
}

<section class="nexus-panel">
    <div class="nexus-panel-header">
        <h2>Risk Heatmap</h2>
        <span class="nexus-panel-subtitle">Probability (composite supplier risk score) × Impact (revenue exposure, normalized to this network) — §35</span>
    </div>

    @if (!Model.Any())
    {
        <p class="nexus-muted">No suppliers found.</p>
    }
    else
    {
        <table class="nexus-table nexus-heatmap-table">
            <thead>
                <tr><th></th><th>Low Impact</th><th>Med Impact</th><th>High Impact</th></tr>
            </thead>
            <tbody>
                @foreach (var probBucket in new[] { "High", "Med", "Low" })
                {
                    <tr>
                        <th>@probBucket Probability</th>
                        @foreach (var impactBucket in new[] { "Low", "Med", "High" })
                        {
                            var cells = grid[(probBucket, impactBucket)];
                            var severityClass = (probBucket, impactBucket) switch
                            {
                                ("High", "High") or ("High", "Med") or ("Med", "High") => "nexus-heat-critical",
                                ("Low", "Low") => "nexus-heat-low",
                                _ => "nexus-heat-medium"
                            };
                            <td class="nexus-heat-cell @severityClass">
                                @if (cells.Any())
                                {
                                    foreach (var c in cells)
                                    {
                                        <div class="nexus-heat-entry" title="Probability @c.Probability.ToString("P0"), revenue exposure $@c.RevenueExposureEstimate.ToString("N0")">
                                            @c.EntityName
                                        </div>
                                    }
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>

        <table class="nexus-table" style="margin-top:20px;">
            <thead><tr><th>Supplier</th><th>Probability</th><th>Impact (normalized)</th><th>Revenue Exposure</th></tr></thead>
            <tbody>
                @foreach (var c in Model.OrderByDescending(c => c.Probability * c.ImpactScore))
                {
                    <tr>
                        <td>@c.EntityName</td>
                        <td>@c.Probability.ToString("P0")</td>
                        <td>@c.ImpactScore.ToString("P0")</td>
                        <td>$@c.RevenueExposureEstimate.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
