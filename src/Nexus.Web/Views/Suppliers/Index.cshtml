@model List<SupplierRowViewModel>
@{
    ViewData["Title"] = "Supply Network";
}

<section class="nexus-panel">
    <div class="nexus-panel-header">
        <h2>Suppliers</h2>
        <span class="nexus-panel-subtitle">Composite risk score — configurable weights, §7</span>
    </div>

    <table class="nexus-table">
        <thead>
            <tr>
                <th>Supplier</th><th>Country</th><th>Reliability</th><th>Lead Time</th><th>Capacity</th><th>Risk Score</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                var riskClass = row.RiskScore >= 65 ? "nexus-risk-high" : row.RiskScore >= 40 ? "nexus-risk-medium" : "nexus-risk-low";
                <tr>
                    <td>@row.Supplier.Name</td>
                    <td>@row.Supplier.Country</td>
                    <td>@row.Supplier.ReliabilityPercent%</td>
                    <td>@row.Supplier.DefaultLeadTimeDays days</td>
                    <td>@row.Supplier.MonthlyCapacity.ToString("N0")/mo</td>
                    <td><span class="nexus-risk-badge @riskClass">@row.RiskScore</span></td>
                </tr>
            }
        </tbody>
    </table>
</section>
