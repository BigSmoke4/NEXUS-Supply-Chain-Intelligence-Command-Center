@model CommandCenterViewModel
@{
    ViewData["Title"] = "Command Center";
}

<section class="nexus-panel nexus-twin-switcher">
    <span class="nexus-panel-subtitle" style="margin-right:12px;">Digital Twin (§58):</span>
    <a class="nexus-twin-tab @(Model.Mode == DigitalTwinMode.Live ? "active" : "")" asp-action="Index" asp-route-mode="live">LIVE</a>
    <a class="nexus-twin-tab @(Model.Mode == DigitalTwinMode.Historical ? "active" : "")" asp-action="Index" asp-route-mode="historical">HISTORICAL</a>
    <a class="nexus-twin-tab @(Model.Mode == DigitalTwinMode.Simulated ? "active" : "")" asp-action="Index" asp-route-mode="simulated">SIMULATED</a>
</section>

<section class="nexus-panel nexus-panel-metrics">
    <div class="nexus-metric">
        <div class="nexus-metric-label">Network Health</div>
        <div class="nexus-metric-value nexus-glow-ok">@Model.NetworkHealthPercent%</div>
    </div>
    <div class="nexus-metric">
        <div class="nexus-metric-label">Revenue at Risk</div>
        <div class="nexus-metric-value nexus-glow-danger">$@Model.RevenueAtRisk.ToString("N0")</div>
    </div>
    <div class="nexus-metric">
        <div class="nexus-metric-label">Active Disruptions</div>
        <div class="nexus-metric-value nexus-glow-warning">@Model.ActiveDisruptions</div>
    </div>
    <div class="nexus-metric">
        <div class="nexus-metric-label">Critical Suppliers</div>
        <div class="nexus-metric-value nexus-glow-warning">@Model.CriticalSupplierCount</div>
    </div>
    <div class="nexus-metric">
        <div class="nexus-metric-label">Products at Risk</div>
        <div class="nexus-metric-value nexus-glow-danger">@Model.ProductsAtRisk</div>
    </div>
</section>

@if (Model.Mode == DigitalTwinMode.Simulated)
{
    <section class="nexus-panel">
        <div class="nexus-panel-header">
            <h2>Simulated State</h2>
            <span class="nexus-panel-subtitle">Overlaying the most recent computed scenario result, not live data</span>
        </div>
        @if (Model.SimulatedScenario?.LastResult is null)
        {
            <p class="nexus-muted">No scenario has been run yet. <a asp-controller="Scenarios" asp-action="Builder">Run one</a> to populate the simulated twin state.</p>
        }
        else
        {
            var r = Model.SimulatedScenario.LastResult;
            <p>Showing: <strong>@Model.SimulatedScenario.Name</strong></p>
            <div class="nexus-summary-grid">
                <div><span class="nexus-summary-label">Revenue at Risk</span><span class="nexus-summary-value nexus-glow-danger">$@r.RevenueAtRisk.ToString("N0")</span></div>
                <div><span class="nexus-summary-label">Products Affected</span><span class="nexus-summary-value">@r.ProductsAffected</span></div>
                <div><span class="nexus-summary-label">Recovery</span><span class="nexus-summary-value">@r.RecoveryDays days</span></div>
            </div>
            <a class="nexus-button nexus-button-primary" style="margin-top:12px;" asp-controller="Scenarios" asp-action="Results" asp-route-id="@Model.SimulatedScenario.Id">View full cascade & timeline →</a>
        }
    </section>
}
else if (Model.Mode == DigitalTwinMode.Historical)
{
    <section class="nexus-panel">
        <div class="nexus-panel-header">
            <h2>Historical Record</h2>
            <span class="nexus-panel-subtitle">Real audit trail (§38) — what actually happened, not a live snapshot</span>
        </div>
        @if (!Model.AuditHistory.Any())
        {
            <p class="nexus-muted">No audit history yet.</p>
        }
        else
        {
            <table class="nexus-table">
                <thead><tr><th>When</th><th>Action</th><th>By</th><th>Detail</th></tr></thead>
                <tbody>
                    @foreach (var a in Model.AuditHistory)
                    {
                        <tr>
                            <td>@a.AtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@a.Action</td>
                            <td>@(a.UserId ?? "system")</td>
                            <td>@(a.AfterState ?? a.BeforeState ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (Model.ResolvedAlerts.Any())
        {
            <h3 style="margin-top:20px;">Resolved Alerts</h3>
            <ul>
                @foreach (var a in Model.ResolvedAlerts)
                {
                    <li>@a.Title — resolved @a.ResolvedAtUtc?.ToString("yyyy-MM-dd")</li>
                }
            </ul>
        }
    </section>
}

<section class="nexus-panel nexus-panel-graph">
    <div class="nexus-panel-header">
        <h2>Supply Network</h2>
        <span class="nexus-panel-subtitle">@Model.NodeCount nodes · @Model.EdgeCount relationships</span>
    </div>

    <div class="nexus-graph-controls">
        <input type="text" id="graph-search" placeholder="Search nodes…" class="nexus-graph-search" />
        <button type="button" id="graph-clear-focus" class="nexus-button">Clear focus</button>
        <span class="nexus-muted" style="font-size:0.78rem;">Scroll to zoom · drag to pan · click a node to focus its neighbors</span>
    </div>
    <div id="nexus-graph-canvas"
         class="nexus-graph-canvas"
         data-nodes='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Nodes.Select(n => new { id = n.Id, name = n.Name, type = n.Type.ToString() })))'
         data-edges='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Edges.Select(e => new { source = e.SourceNodeId, target = e.TargetNodeId, type = e.Type.ToString() })))'
         role="img"
         aria-label="Supply chain dependency graph">
    </div>

    @if (Model.SinglePointsOfFailure.Any())
    {
        <div class="nexus-alert nexus-alert-critical" role="alert">
            <strong>Single points of failure detected:</strong> @string.Join(", ", Model.SinglePointsOfFailure)
        </div>
    }

    <details class="nexus-graph-a11y-fallback">
        <summary>Accessible text view of the network</summary>
        <p class="nexus-muted">Every relationship below mirrors an edge in the graph above, so a screen-reader user gets the dependency structure, not just a node list.</p>
        <ul>
            @foreach (var n in Model.Nodes)
            {
                var outgoing = Model.Edges.Where(e => e.SourceNodeId == n.Id)
                    .Select(e => Model.Nodes.FirstOrDefault(t => t.Id == e.TargetNodeId)?.Name)
                    .Where(name => name != null).ToList();
                <li>
                    <strong>@n.Type: @n.Name</strong>
                    @if (outgoing.Any())
                    {
                        <span> → @string.Join(", ", outgoing)</span>
                    }
                </li>
            }
        </ul>
    </details>
</section>

@if (Model.OpenAlerts.Any())
{
    <section class="nexus-panel">
        <div class="nexus-panel-header">
            <h2>Open Alerts</h2>
            <span class="nexus-panel-subtitle">Generated deterministically from simulation results (§36)</span>
        </div>
        <div class="nexus-strategy-grid">
            @foreach (var a in Model.OpenAlerts)
            {
                var cls = a.Severity == AlertSeverity.Critical ? "nexus-alert-critical" : "";
                <div class="nexus-strategy-card @cls">
                    <div class="nexus-strategy-title">@a.Severity: @a.Title</div>
                    <p>@a.Detail</p>
                    <div style="display:flex;gap:8px;margin-top:8px;">
                        <form asp-controller="CommandCenter" asp-action="AcknowledgeAlert" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="alertId" value="@a.Id" />
                            <button type="submit" class="nexus-button">Acknowledge</button>
                        </form>
                        <form asp-controller="CommandCenter" asp-action="ResolveAlert" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="alertId" value="@a.Id" />
                            <button type="submit" class="nexus-button nexus-button-approve">Resolve</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </section>
}

<section class="nexus-panel nexus-panel-recent">
    <div class="nexus-panel-header">
        <h2>Recent Scenarios</h2>
        <a class="nexus-button nexus-button-primary" asp-controller="Scenarios" asp-action="Builder">Simulate Disruption</a>
    </div>

    @if (!Model.RecentScenarios.Any())
    {
        <p class="nexus-muted">No scenarios yet. Run your first disruption simulation to populate the command center.</p>
    }
    else
    {
        <table class="nexus-table">
            <thead>
                <tr><th>Scenario</th><th>Revenue at Risk</th><th>Recovery</th><th>Service Level</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var s in Model.RecentScenarios)
                {
                    <tr>
                        <td>@s.Name</td>
                        <td>@(s.LastResult != null ? $"${s.LastResult.RevenueAtRisk:N0}" : "—")</td>
                        <td>@(s.LastResult != null ? $"{s.LastResult.RecoveryDays} days" : "—")</td>
                        <td>@(s.LastResult != null ? $"{s.LastResult.ServiceLevelPercent}%" : "—")</td>
                        <td><a asp-controller="Scenarios" asp-action="Results" asp-route-id="@s.Id">View →</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
