@model List<AdminUserRow>
@{
    ViewData["Title"] = "User & Role Administration";
    var allRoles = ViewBag.AllRoles as string[] ?? Array.Empty<string>();
}

<section class="nexus-panel">
    <div class="nexus-panel-header">
        <h2>Users & Roles</h2>
        <span class="nexus-panel-subtitle">System Administrator only — every change is audited</span>
    </div>

    <table class="nexus-table">
        <thead>
            <tr><th>User</th><th>Current Roles</th><th>Assign</th></tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <td>@row.User.DisplayName <span class="nexus-muted">(@row.User.Email)</span></td>
                    <td>
                        @foreach (var role in row.Roles)
                        {
                            <form asp-controller="Admin" asp-action="RevokeRole" method="post" style="display:inline-block;margin-right:6px;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@row.User.Id" />
                                <input type="hidden" name="role" value="@role" />
                                <button type="submit" class="nexus-risk-badge nexus-risk-medium" style="border:none;cursor:pointer;" title="Click to revoke">@role ×</button>
                            </form>
                        }
                    </td>
                    <td>
                        <form asp-controller="Admin" asp-action="AssignRole" method="post" style="display:flex;gap:8px;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@row.User.Id" />
                            <select name="role">
                                @foreach (var role in allRoles)
                                {
                                    <option value="@role">@role</option>
                                }
                            </select>
                            <button type="submit" class="nexus-button">Assign</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>
