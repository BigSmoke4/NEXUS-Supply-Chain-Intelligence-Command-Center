@model AiInvestigationResult

<div class="nexus-ai-panel">
    <h4>AI Investigation</h4>
    <ul class="nexus-agent-trace">
        @foreach (var step in Model.Trace)
        {
            <li class="nexus-trace-@step.Status">
                <span class="nexus-trace-agent">@step.AgentName</span>
                <span class="nexus-trace-action">@step.Action</span>
            </li>
        }
    </ul>

    <h4>Evidence (@Model.Evidence.Count signals)</h4>
    <ul class="nexus-evidence-list">
        @foreach (var e in Model.Evidence)
        {
            <li><strong>[@e.Source]</strong> @e.Fact <span class="nexus-muted">(@((e.Confidence * 100).ToString("0"))% confidence)</span></li>
        }
    </ul>

    <h4>Narrative <span class="nexus-confidence-badge">Overall confidence: @Model.OverallConfidence%</span></h4>
    <p class="nexus-ai-narrative">@Model.NarrativeExplanation</p>
</div>
