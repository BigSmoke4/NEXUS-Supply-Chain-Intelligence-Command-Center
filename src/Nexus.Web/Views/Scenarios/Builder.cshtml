@{
    ViewData["Title"] = "Scenario Builder";
    var nodes = ViewBag.Nodes as List<SupplyNode> ?? new List<SupplyNode>();
}

<section class="nexus-panel nexus-panel-form">
    <div class="nexus-panel-header">
        <h2>Simulate a Disruption</h2>
        <span class="nexus-panel-subtitle">Deterministic simulation — results are calculated, not guessed by the AI</span>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="nexus-alert nexus-alert-critical" role="alert">
            @foreach (var e in ViewData.ModelState.SelectMany(kvp => kvp.Value!.Errors))
            {
                <div>@e.ErrorMessage</div>
            }
        </div>
    }

    <div class="nexus-field" style="margin-bottom:18px;">
        @Html.AntiForgeryToken()
        <span>Describe the disruption in plain language (optional)</span>
        <textarea id="nl-scenario-input" rows="2" placeholder="e.g. Simulate Supplier Alpha shutting down for 30 days"></textarea>
        <button type="button" id="nl-parse-btn" class="nexus-button" style="margin-top:8px;width:fit-content;"
                data-parse-url="@Url.Action("ParseNaturalLanguage", "Scenarios")">Parse & fill form</button>
        <div id="nl-clarifications" class="nexus-alert" style="display:none;"></div>
    </div>

    <form asp-controller="Scenarios" asp-action="Run" method="post" class="nexus-form" id="scenario-form">
        @Html.AntiForgeryToken()

        <label class="nexus-field">
            <span>Scenario name</span>
            <input type="text" name="name" placeholder="e.g. Supplier Alpha shutdown — 30 days" />
        </label>

        <label class="nexus-field">
            <span>Affected node</span>
            <select name="nodeId" id="field-nodeId" required>
                @foreach (var n in nodes)
                {
                    <option value="@n.Id">@n.Type: @n.Name</option>
                }
            </select>
        </label>

        <label class="nexus-field">
            <span>Disruption type</span>
            <select name="type" id="field-type" required>
                @foreach (var t in Enum.GetValues<DisruptionType>())
                {
                    <option value="@t">@t</option>
                }
            </select>
        </label>

        <label class="nexus-field">
            <span>Duration (days)</span>
            <input type="number" name="durationDays" id="field-durationDays" value="30" min="1" max="365" required />
        </label>

        <label class="nexus-field">
            <span>Severity (% capacity reduction)</span>
            <input type="number" name="severityPercent" id="field-severityPercent" value="100" min="1" max="100" required />
        </label>

        <button type="submit" class="nexus-button nexus-button-primary nexus-button-run">RUN SIMULATION</button>
    </form>
</section>

<section class="nexus-panel">
    <div class="nexus-panel-header"><h2>Pre-built demo scenarios</h2></div>
    <ul class="nexus-demo-scenario-list">
        <li>Supplier Alpha shuts down for 30 days (single-source dependency for Component X)</li>
        <li>Factory Beta loses 50% capacity</li>
        <li>Major shipping route becomes unavailable</li>
        <li>Demand increases 40%</li>
        <li>Component X becomes unavailable globally</li>
        <li>Two suppliers fail simultaneously (cascading risk)</li>
    </ul>
    <p class="nexus-muted">Select the corresponding node above and set duration/severity to reproduce any of these.</p>
</section>
