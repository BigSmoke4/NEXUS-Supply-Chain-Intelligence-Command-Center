@model List<Scenario>
@{
    ViewData["Title"] = "Scenario Comparison";
    var metrics = new (string Label, Func<ScenarioResult, string> Format)[]
    {
        ("Revenue at Risk", r => $"${r.RevenueAtRisk:N0}"),
        ("Products Affected", r => r.ProductsAffected.ToString()),
        ("Customers Affected", r => r.CustomersAffected.ToString()),
        ("Recovery Time", r => $"{r.RecoveryDays} days"),
        ("Service Level", r => $"{r.ServiceLevelPercent}%"),
        ("Overall Risk Score", r => r.OverallRiskScore.ToString()),
    };
}

<section class="nexus-panel">
    <div class="nexus-panel-header">
        <h2>Scenario Comparison</h2>
        <a class="nexus-button" asp-controller="ScenarioComparison" asp-action="Index">← Back to picker</a>
    </div>

    @if (Model.Count < 2)
    {
        <p class="nexus-muted">Select at least two scenarios to compare.</p>
    }
    else
    {
        <table class="nexus-table">
            <thead>
                <tr>
                    <th>Metric</th>
                    @foreach (var s in Model)
                    {
                        <th>@s.Name</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var (label, format) in metrics)
                {
                    <tr>
                        <td><strong>@label</strong></td>
                        @foreach (var s in Model)
                        {
                            <td>@(s.LastResult != null ? format(s.LastResult) : "—")</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
