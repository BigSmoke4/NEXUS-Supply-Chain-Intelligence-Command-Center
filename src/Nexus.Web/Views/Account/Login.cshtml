@{ ViewData["Title"] = "Sign in"; }

<section class="nexus-panel nexus-panel-form" style="max-width:420px;margin:40px auto;">
    <div class="nexus-panel-header"><h2>Sign in to NEXUS</h2></div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="nexus-alert nexus-alert-critical" role="alert">
            @foreach (var e in ViewData.ModelState.SelectMany(kvp => kvp.Value!.Errors))
            {
                <div>@e.ErrorMessage</div>
            }
        </div>
    }

    <form asp-controller="Account" asp-action="Login" method="post" class="nexus-form" style="grid-template-columns:1fr;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        <label class="nexus-field"><span>Email</span><input type="email" name="email" required /></label>
        <label class="nexus-field"><span>Password</span><input type="password" name="password" required /></label>
        <button type="submit" class="nexus-button nexus-button-primary nexus-button-run">SIGN IN</button>
    </form>
    <p class="nexus-muted" style="margin-top:14px;">No account? <a asp-controller="Account" asp-action="Register">Register</a></p>
</section>
